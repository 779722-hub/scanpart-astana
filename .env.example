# =============================================================================
# SCANPART.ASTANA — environment template
# Copy to `.env` (NEVER commit `.env`) and fill in real values from secret store.
# Production values live in GitHub Actions Secrets (Settings → Secrets → Actions)
# and are deployed to /opt/scanpart/.env on the VPS via the sync-env workflow.
# =============================================================================

# --- Phaeton API (server-only, NEVER expose to client) -----------------------
PHAETON_BASE_URL=https://api.phaeton.kz
PHAETON_USER_GUID=
PHAETON_API_KEY=
PHAETON_CONTRAGENT_GUID=
# Override if /api/Dictionary lookup fails or for offline dev:
PHAETON_ASTANA_WAREHOUSE_ID=

# --- Shate-M (second supplier: price/stock + VIN catalog) --------------------
# Trading API (apikey → Bearer): article price/stock, Astana warehouse filter.
SHATEM_BASE_URL=https://api.shate-m.kz
SHATEM_API_KEY=
# Optional override if Astana warehouse auto-detection (/locations) ever fails:
SHATEM_ASTANA_LOCATION_CODE=
# Catalog (Laximo) auth is a WEB session (cookie), NOT the apikey. The server
# logs in autonomously with these and keeps/refreshes the session itself.
SHATEM_WEB_BASE=https://shate-m.kz
SHATEM_WEB_LOGIN=
SHATEM_WEB_PASSWORD=
# Dev-only fallback: a raw browser Cookie header instead of login (short-lived).
# SHATEM_SESSION_COOKIE=

# --- Autotrade (sklad.autotrade.kz — wholesale catalog, web session) ---------
# Search is behind a login (plain AJAX POST, no client-side hashing). Autonomous
# login uses these; the host is behind DDoS-Guard so route through the same
# residential proxy as Phaeton (AUTOTRADE_PROXY_URL, falls back to PHAETON_PROXY_URL).
AUTOTRADE_LOGIN=
AUTOTRADE_PASSWORD=
# Optional: dedicated proxy for Autotrade (else reuses PHAETON_PROXY_URL).
# AUTOTRADE_PROXY_URL=
# Dev-only fallback: a raw browser Cookie header instead of login (short-lived).
# AUTOTRADE_SESSION_COOKIE=
# Override base host if needed (default https://sklad.autotrade.kz).
# AUTOTRADE_BASE=

# --- Interkom (opt.interkom.kz — B2B wholesale catalog, web session) ----------
# Enable the supplier in Admin → Settings ("Поставщик Interkom", default off).
# On Vercel routes through the same KZ proxy (INTERKOM_PROXY_URL, falls back to
# PHAETON_PROXY_URL). Direct when no proxy env is set (local dev).
INTERKOM_LOGIN=
INTERKOM_PASSWORD=
# Optional: dedicated proxy for Interkom (else reuses PHAETON_PROXY_URL).
# INTERKOM_PROXY_URL=
# Override base host if needed (default https://opt.interkom.kz).
# INTERKOM_BASE=

# --- Google Sheets (service account) -----------------------------------------
# Encode service-account.json: `base64 -w0 service-account.json` → paste below
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
SHEETS_SPREADSHEET_ID=

# --- Cloudinary (image hosting + CDN) ----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=scanpart
# Same value as CLOUDINARY_CLOUD_NAME, exposed to the browser for image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Telegram bot ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Auth: sessions, password hashing, first-time bootstrap ------------------
# 32+ random chars. Generate with: openssl rand -base64 48
IRON_SESSION_PASSWORD=
# Random secret blended into bcrypt before hashing. Generate the same way.
BCRYPT_PEPPER=
# One-shot token to create the first owner user via /api/admin/auth/bootstrap.
# Unset (or empty) after first owner is created.
BOOTSTRAP_TOKEN=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=SCANPART.ASTANA
NEXT_PUBLIC_SITE_URL=https://scanpart.kz
